    "Logging only. This section does not interpret or predict results, diagnose conditions, or provide contraception guidance.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging only. This section does not interpret or predict results, diagnose conditions, or provide contraception guidance."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于记录。本区不会解读或预测结果、诊断疾病，也不提供避孕指导。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo registro. Esta sección no interpreta ni predice resultados, no diagnostica ni ofrece orientación anticonceptiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録のみを行います。このセクションでは結果の解釈や予測、診断、避妊に関する指導は行いません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於記錄。本區不會解讀或預測結果、診斷疾病，也不提供避孕指導。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록만 해요. 이 섹션은 결과를 해석하거나 예측하지 않으며, 질환을 진단하거나 피임 방법을 안내하지 않아요."
          }
        }
      }
    },
