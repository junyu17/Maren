    },
    "你最近的平均心情是 %@(满分 5)。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recent average mood is %@ out of 5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近的平均心情是 %@(满分 5)。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ánimo medio reciente es %@ sobre 5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の平均的な気分は%@ / 5です。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你最近的平均心情是 %@(滿分 5)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 평균 기분은 5점 만점에 %@점이에요."
          }
        }
      }
    },
    "你的「%@」常在黄体期升高,这几天注意休息。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your \"%@\" tends to rise during the luteal phase — take it easy these days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的「%@」常在黄体期升高,这几天注意休息。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu «%@» suele subir en la fase lútea: tómatelo con calma estos días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は黄体期に高まりやすい傾向があります。この時期は無理せず過ごしましょう。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的「%@」常在黃體期升高,這幾天注意休息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'이(가) 황체기에 높아지는 경향이 있어요. 이 시기에는 무리하지 마세요."
          }
        }
      }
    },
    "你的周期很规律,稳定在 %lld 天左右。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cycles are very regular, holding around %lld days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的周期很规律,稳定在 %lld 天左右。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus ciclos son muy regulares, se mantienen en torno a %lld días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの周期はとても規則的で、%lld日前後で安定しています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的週期很規律,穩定在 %lld 天左右。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기가 매우 규칙적이며 약 %lld일을 유지하고 있어요."
          }
        }
      }
    },
    "你的周期很规律,稳定在 30 天左右。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cycle is very regular, staying around 30 days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的周期很规律,稳定在 30 天左右。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ciclo es muy regular, se mantiene en torno a 30 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの周期はとても規則的で、30日前後で安定しています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的週期很規律,穩定在 30 天左右。"
          }
