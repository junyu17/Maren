    "%@ 天免费试用结束后，将按 %@ / 年自动续费。你可以在试用结束前取消，避免产生费用。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-day free trial ends, then renews at %2$@ / year. Cancel before the trial ends to avoid a charge."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 天免费试用结束后，将按 %2$@ / 年自动续费。你可以在试用结束前取消，避免产生费用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba gratis de %1$@ días termina y luego se renueva por %2$@ / año. Cancela antes de que acabe para evitar el cargo."
          }
        }
      }
    },
    "%@ 小时": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ h"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
