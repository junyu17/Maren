      }
    },
    "你的心情在经期通常偏低,在排卵期相对更好。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your mood is usually lower during your period and relatively better around ovulation."
