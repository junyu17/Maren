    },
    "在预测经期前 2 天提醒你。升级 Premium 可自定义 1–5 天。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you 2 days before your predicted period. Upgrade to Premium to customize 1–5 days."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预测经期前 2 天提醒你。升级 Premium 可自定义 1–5 天。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa 2 días antes de tu periodo previsto. Mejora a Premium para elegir de 1 a 5 días."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測された生理の2日前にお知らせします。Premiumにアップグレードすると1〜5日の範囲でカスタマイズできます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
