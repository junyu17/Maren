    "预测你的经期约在 %lld 天后,可以提前做点准备。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your period may be about %lld days away — maybe prep a little."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测你的经期约在 %lld 天后,可以提前做点准备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que a tu periodo le falten unos %lld días; quizá te venga bien prepararte un poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理まであと約%lld日かもしれません。少し準備しておきましょう。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預測你的經期約在 %lld 天后,可以提前做點準備。"
