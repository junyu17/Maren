        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña es incorrecta o el archivo de copia de seguridad está dañado y no se puede descifrar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが間違っているか、バックアップファイルが破損しているため復号できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "密碼錯誤或備份檔案已損壞,無法解密。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호가 올바르지 않거나 백업 파일이 손상되어 복호화할 수 없어요."
          }
        }
      }
    },
