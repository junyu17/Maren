    "我在用 Maren 记录经期和身体变化,数据只保存在手机里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I use Maren to track my cycle and body changes. My data stays on my phone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在用 Maren 记录经期和身体变化,数据只保存在手机里。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso Maren para registrar mi ciclo y los cambios de mi cuerpo. Mis datos se quedan en mi teléfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
