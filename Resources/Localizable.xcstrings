    "Quickly log your mood in Maren. The entry is queued and saved when Maren is open.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly log your mood in Maren. The entry is queued and saved when Maren is open."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Maren 中快速记录心情。记录会暂存队列,在 Maren 打开时保存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tu ánimo rápidamente en Maren. La entrada queda en cola y se guarda al abrir Maren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Marenで気分をすばやく記録します。記録はキューに入り、Marenを開くと保存されます。"
          }
