          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ h"
          }
        }
      }
    },
    "%@ 打卡日(%lld天)平均心情 %@ / 5;非打卡日(%lld天)平均 %@ / 5。仅描述差异,不推断因果。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %@ check-in days (%lld days), average mood was %@ / 5; on non-check-in days (%lld days), average was %@ / 5. Difference only; no causal inference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 打卡日(%lld天)平均心情 %@ / 5;非打卡日(%lld天)平均 %@ / 5。仅描述差异,不推断因果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los días con registro de %@ (%lld días), el ánimo medio fue %@ / 5; en los días sin registro (%lld días), la media fue %@ / 5. Solo es una diferencia; no implica causalidad."
          }
        }
      }
    },
    "%@ 打卡日平均每天记录 %@ 个追踪项,非打卡日平均 %@ 个。仅描述差异,不推断因果。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On %@ check-in days, an average of %@ trackers were recorded per day; on non-check-in days, the average was %@. Difference only; no causal inference."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 打卡日平均每天记录 %@ 个追踪项,非打卡日平均 %@ 个。仅描述差异,不推断因果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En los días con registro de %@ se anotaron %@ seguimientos al día de media; en los días sin registro, la media fue %@. Solo es una diferencia; no implica causalidad."
          }
        }
      }
    },
