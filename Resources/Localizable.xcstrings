    },
    "密码至少 8 个字符。Maren 无法恢复或重置密码;忘记密码将无法导入备份。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords must be at least 8 characters. Maren cannot recover or reset the password; if you forget it, the backup cannot be imported."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码至少 8 个字符。Maren 无法恢复或重置密码;忘记密码将无法导入备份。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La contraseña debe tener al menos 8 caracteres. Maren no puede recuperarla ni restablecerla; si la olvidas, no podrás importar la copia de seguridad."
          }
        }
      }
    },
