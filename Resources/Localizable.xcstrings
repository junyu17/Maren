    "预测你的经期约在 %lld 天后,可以提前做点准备。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your period may be about %lld days away — maybe prep a little."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测你的经期约在 %lld 天后,可以提前做点准备。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que a tu periodo le falten unos %lld días; quizá te venga bien prepararte un poco."
          }
        }
      }
    },
    "预测你的经期约在 2 天后,可以提前做点准备。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your period is predicted in about 2 days — a little prep may help."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预测你的经期约在 2 天后,可以提前做点准备。"
          }
        },
        "es": {
          "stringUnit": {
