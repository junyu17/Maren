            "state": "translated",
            "value": "对自己好一点"
          }
        }
      }
    },
    "经期临近,黄体期里情绪和身体可能起伏,温柔对待自己。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
