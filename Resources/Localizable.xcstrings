    "经期已保存,但未能刷新提醒和小组件。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Period saved, but reminders and widgets could not be refreshed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经期已保存,但未能刷新提醒和小组件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Periodo guardado, pero no se pudieron actualizar los recordatorios ni los widgets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生理を保存しましたが、リマインダーとウィジェットを更新できませんでした。"
