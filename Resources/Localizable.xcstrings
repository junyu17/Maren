    "Maren 只学习你自己的真实周期,不套用「第 14 天」模板。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maren learns only from your real cycles — no fixed \"day 14\" template."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Maren 只学习你自己的真实周期,不套用「第 14 天」模板。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maren aprende solo de tus ciclos reales, sin la plantilla fija del «día 14»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Marenはあなた自身の実際の周期だけから学習します。「14日目」のような固定テンプレートは使いません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Maren 只學習你自己的真實週期,不套用「第 14 天」模板。"
          }
        }
      }
    },
    "Maren 已锁定": {
      "localizations": {
