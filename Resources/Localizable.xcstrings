    "包括周期长度、经期天数、心情、睡眠、体重和追踪项的变化趋势。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes cycle length, period days, mood, sleep, weight, and tracker change trends."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括周期长度、经期天数、心情、睡眠、体重和追踪项的变化趋势。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye duración del ciclo, días de periodo, ánimo, sueño, peso y tendencias de los seguimientos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周期の長さ、生理日数、気分、睡眠、体重、トラッカーの変化傾向を含みます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包括週期長度、經期天數、心情、睡眠、體重和追蹤項的變化趨勢。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주기 길이, 생리 일수, 기분, 수면, 체중, 추적 항목의 변화 추이를 포함해요."
          }
        }
      }
    },
    "升级 Maren Premium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to Maren Premium"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级 Maren Premium"
          }
        },
        "es": {
          "stringUnit": {
