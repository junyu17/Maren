    "黄体期情绪和身体容易起伏,对自己温柔一点。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mood and body can fluctuate during the luteal phase — be gentle with yourself."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄体期情绪和身体容易起伏,对自己温柔一点。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ánimo y el cuerpo pueden fluctuar en la fase lútea: trátate con cariño."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黄体期は気分や体調が揺れやすい時期です。自分に優しくしてください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "黃體期情緒和身體容易起伏,對自己溫柔一點。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황체기에는 기분과 몸이 오르내릴 수 있어요. 스스로에게 다정하게 대해 주세요."
          }
        }
      }
    },
    "默认玫瑰色。升级 Premium 解锁全部 5 套配色。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default rose. Upgrade to Premium to unlock all 5 themes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认玫瑰色。升级 Premium 解锁全部 5 套配色。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rosa por defecto. Mejora a Premium para desbloquear los 5 temas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトはローズです。Premiumにアップグレードすると、5種類すべてのテーマをロック解除できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設玫瑰色。升級 Premium 解鎖全部 5 套配色。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본은 로즈예요. Premium으로 업그레이드하면 테마 5가지를 모두 사용할 수 있어요."
          }
        }
      }
    },
