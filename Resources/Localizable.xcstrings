    "点击/按下后,条目先入队列;下次打开 Maren 时自动保存到日历。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a tap or press, the entry is queued and saved to your calendar the next time Maren opens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击/按下后,条目先入队列;下次打开 Maren 时自动保存到日历。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras un toque o una pulsación, la entrada queda en cola y se guarda en tu calendario la próxima vez que abras Maren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップまたは長押しすると、記録はキューに入り、次回Marenを開いたときにカレンダーに保存されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選/按下後,條目先入佇列;下次開啟 Maren 時自動儲存到日曆。"
          }
        }
      }
    },
