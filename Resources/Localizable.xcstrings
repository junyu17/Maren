    "Only the selected method and reminder preference are recorded locally. No effectiveness, missed-dose, diagnosis, or medical advice is provided here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the selected method and reminder preference are recorded locally. No effectiveness, missed-dose, diagnosis, or medical advice is provided here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在本机记录所选方式和提醒偏好。此处不提供有效性、漏服、诊断或医疗建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardan localmente el método elegido y la preferencia de recordatorio. Aquí no se ofrece información sobre eficacia, dosis olvidadas, diagnóstico ni consejo médico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した方法とリマインダーの設定のみが端末内に記録されます。有効性、飲み忘れ、診断、医学的な助言は提供されません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在本機記錄所選方式和提醒偏好。此處不提供有效性、漏服、診斷或醫療建議。"
          }
        }
      }
    },
