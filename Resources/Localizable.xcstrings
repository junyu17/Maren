    "更懂自己的身体节律，不交出健康数据": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Understand your body's rhythm without giving up your health data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更懂自己的身体节律，不交出健康数据"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiende el ritmo de tu cuerpo sin renunciar a tus datos de salud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "健康データを差し出すことなく、自分の体のリズムを理解する"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更懂自己的身體節律，不交出健康資料"
          }
        }
      }
    },
    "替换会删除本机现有的经期、每日记录、用药、自定义追踪项和打卡历史,且无法撤销。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replacing will permanently delete existing periods, daily logs, medications, custom trackers, and check-in history on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替换会删除本机现有的经期、每日记录、用药、自定义追踪项和打卡历史,且无法撤销。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reemplazar se eliminarán definitivamente los periodos, registros diarios, medicamentos, seguimientos personalizados y el historial de registros de este dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "置き換えると、この端末にある既存の生理記録・日次記録・薬・カスタムトラッカー・チェックイン履歴が完全に削除されます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替換會刪除本機現有的經期、每日記錄、用藥、自定義追蹤項和打卡歷史,且無法撤銷。"
          }
        }
      }
    },
