            "value": "This backup is from an unsupported version. Update Maren and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份备份来自不受支持的版本,请更新 Maren 后重试。"
          }
        },
        "es": {
