          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los análisis se basan en tus propios registros y se calculan localmente en tu dispositivo. Todas las conclusiones son descripciones observacionales, no relaciones causales ni consejo médico."
          }
        }
