    "你在%@最常记录「%@」。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You log %2$@ most during your %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
