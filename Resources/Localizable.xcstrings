    "探索你的数据中睡眠、心情、周期阶段、用药之间的关联模式。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore correlation patterns between sleep, mood, cycle phases, and medication in your data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探索你的数据中睡眠、心情、周期阶段、用药之间的关联模式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora las correlaciones entre sueño, ánimo, fases del ciclo y medicación en tus datos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠・気分・周期のフェーズ・服薬の関連パターンを確認できます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "探索你的資料中睡眠、心情、週期階段、用藥之間的關聯模式。"
          }
        }
      }
    },
    "探索睡眠、心情、周期阶段、用药打卡之间的关联模式;所有结论均为观察性描述,不构成因果或医学建议。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore observed patterns among sleep, mood, cycle phases, and medication check-ins. These observations do not establish causation or medical advice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "探索睡眠、心情、周期阶段、用药打卡之间的关联模式;所有结论均为观察性描述,不构成因果或医学建议。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora los patrones observados entre sueño, ánimo, fases del ciclo y registros de medicación. Estas observaciones no establecen causalidad ni son consejo médico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠・気分・周期のフェーズ・服薬チェックインの間で観察されたパターンを確認できます。これらの観察は因果関係や医学的な助言を示すものではありません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "探索睡眠、心情、週期階段、用藥打卡之間的關聯模式;所有結論均為觀察性描述,不構成因果或醫學建議。"
          }
        }
      }
    },
