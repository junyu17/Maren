        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有数据均为模拟,不会影响你的真实记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los datos son simulados y no afectarán a tus registros reales."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデータはシミュレーションであり、実際の記録には影響しません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有資料均為模擬,不會影響你的真實記錄。"
          }
        },
        "ko": {
