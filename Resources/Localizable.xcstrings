          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Maren Premiumにアップグレード"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "升級 Maren Premium"
          }
        },
