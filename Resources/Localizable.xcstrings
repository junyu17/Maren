    "在 %lld 个%@日中,心情平均 %@ / 5。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across %lld %@ days, average mood was %@ / 5."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %lld 个%@日中,心情平均 %@ / 5。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En %lld días de %@, el ánimo medio fue %@ / 5."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日間の%@の平均気分は%@ / 5でした。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %lld 個%@日中,心情平均 %@ / 5。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
