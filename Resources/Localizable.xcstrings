      }
    },
    "你的「%@」常在黄体期升高,这几天注意休息。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your \"%@\" tends to rise during the luteal phase — take it easy these days."
          }
        },
        "zh-Hans": {
