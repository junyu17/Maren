          "stringUnit": {
            "state": "translated",
            "value": "备份中有一条用药打卡没有对应的用药记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad contiene un registro de medicación sin su medicamento correspondiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップに、対応する薬が見つからない服薬チェックインが含まれています。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份中有一條用藥打卡沒有對應的用藥記錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에 일치하는 복용약이 없는 복용 체크인이 있어요."
          }
        }
      }
    },
    "The backup could not be saved. Your existing records were not changed.": {
