    "这不是受支持的 Maren 备份文件。": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a supported Maren backup file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
