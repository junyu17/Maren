# macOS
.DS_Store
._*

# Xcode (工程由 project.yml 经 xcodegen 生成,克隆后跑 `xcodegen generate` 即可)
Vela.xcodeproj/
# Vela/Info.plist 与 entitlements 由 xcodegen 从 project.yml 生成,勿提交(避免漂移)
Vela/Info.plist
*.xcuserstate
xcuserdata/
DerivedData/
*.xcscmblueprint
*.xccheckout
build/
tmp/

# 本地 App Store 归档与提审验证产物（体积大，且可能包含签名描述文件）
AppStore/Builds/
AppStore/Review-Response-*/Evidence/
*.xcresult/

# Swift Package Manager
.build/
.swiftpm/configuration/
Package.resolved

# 本地 StoreKit 测试配置(可选;若想在团队间共享测试产品可取消注释)
# *.storekit

# 临时导出
*.csv
*.pdf
